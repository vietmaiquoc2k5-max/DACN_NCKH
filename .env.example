# Required for API management routes. Use a long random value in local .env.
FIREWATCH_API_TOKEN=replace-with-a-long-random-token

# Optional allowlist for RTSP/RTSPS destination hostnames, comma-separated.
# Add only cameras or your authorized MediaMTX host. Example: mediamtx,192.168.1.50
FIREWATCH_RTSP_HOSTS=mediamtx
FIREWATCH_ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
FIREWATCH_API_HOST=127.0.0.1
FIREWATCH_API_PORT=8000
FIREWATCH_API_INTERNAL_URL=http://127.0.0.1:8000
FIREWATCH_PUSH_PUBLIC_ORIGIN=
FIREWATCH_PUSH_ALLOWED_HOSTS=fcm.googleapis.com,updates.push.services.mozilla.com,web.push.apple.com,notify.windows.com
# Optional camera credentials via source references like env:CAMERA_RTSP_CAM01.
# CAMERA_RTSP_CAM01=

# Web Push is opt-in. Generate a VAPID key pair and keep the private key secret.
WEB_PUSH_ENABLED=false
FIREWATCH_VAPID_PUBLIC_KEY=
FIREWATCH_VAPID_PRIVATE_KEY=
FIREWATCH_VAPID_SUBJECT=mailto:admin@example.com
NOTIFICATION_RETRIES=4

FIREWATCH_DB_PATH=alerts.db
FIREWATCH_MODEL_PATH=best.pt
FIREWATCH_MODEL_HOST_PATH=./best.pt
