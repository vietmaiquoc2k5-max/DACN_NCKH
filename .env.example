# Required for API management routes. Use a long random value in local .env.
FIREWATCH_API_TOKEN=replace-with-a-long-random-token

# Optional allowlist for RTSP/RTSPS destination hostnames, comma-separated.
# Add only cameras or your authorized MediaMTX host. Example: mediamtx,192.168.1.50
FIREWATCH_RTSP_HOSTS=mediamtx
# Optional camera credentials via source references like env:CAMERA_RTSP_CAM01.
# CAMERA_RTSP_CAM01=

# Keep secrets out of source control.
ALERTS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TIMEOUT_SEC=8
TELEGRAM_RETRIES=3

FIREWATCH_DB_PATH=alerts.db
FIREWATCH_MODEL_PATH=best.pt
